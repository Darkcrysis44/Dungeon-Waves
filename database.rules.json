{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid)",
        "pl": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "ob": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "ho": { "$uid": { ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid" } },
        "snap": { ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid" },
        "meta": { ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid" }
      }
    }
  }
}
